var BAIDU_WORKER = '';     /* 百度翻译代理 Worker 地址（部署 baidu-mt/cf-mt-worker.js 后获得）；留空则不翻译，退回静态表/英文 */

function flatten(obj, prefix, out){
  out = out || {};
  if (obj && typeof obj === 'object' && !Array.isArray(obj)){
    var keys = Object.keys(obj);
    if (keys.length === 0){ out[prefix] = obj; }
    else { for (var i=0;i<keys.length;i++){ flatten(obj[keys[i]], prefix ? prefix+'.'+keys[i] : keys[i], out); } }
  } else { out[prefix] = obj; }
  return out;
}
/* 容错解析：纯 JSON -> JSONP/前缀包裹 -> 逐个大括号做配平扫描，取能解析出的最大对象 */
function safeJson(s){
  if (s && typeof s === 'object') return s;
  s = String(s);
  try { return JSON.parse(s); } catch(e){}
  var best = null, bestLen = 0;
  for (var i=0;i<s.length;i++){
    if (s.charAt(i) !== '{') continue;
    var depth=0, inStr=false, esc=false;
    for (var j=i;j<s.length;j++){
      var c = s.charAt(j);
      if (esc){ esc=false; continue; }
      if (c === '\\'){ esc=true; continue; }
      if (c === '"'){ inStr = !inStr; continue; }
      if (inStr) continue;
      if (c === '{') depth++;
      else if (c === '}'){
        depth--;
        if (depth === 0){
          var frag = s.slice(i, j+1);
          try {
            var o = JSON.parse(frag);
            if (o && typeof o === 'object' && frag.length > bestLen){ best = o; bestLen = frag.length; }
          } catch(e2){}
          break;
        }
      }
    }
  }
  return best;
}
function fmtVal(v){
  if (v === null || v === undefined) return '';
  if (Array.isArray(v)) return v.filter(function(x){ return x !== '' && x != null; }).join(' ');
  return (typeof v === 'object') ? '' : String(v);
}
/* 字段别名兜底（不含自身键，防止递归） */
