/* ===== 统一自适应读取与回填 v3 =====
 * 每个块通过 data-api 声明接口地址，data-tpl 声明回填模板，
 * 由本段 JS 统一拉取、自适应解析 JSON 并填入对应块。
 * 可选属性：data-jsonp（JSONP 回调名）/ data-charset（脚本编码）/ data-cors="no"（已知无 CORS）
 */
var PROXY_BASE = 'https://ippx.chaosection.top/?url=';      /* 自有反代（chaosection.top）；反代代码见 cf-proxy-worker.js；需后端按 ?url= 约定部署 */
